# BlueskyEspelunca
# Não coloque senhas, tokens ou chaves privadas neste arquivo público.

PDS_HOSTNAME=espelunca.blue
PDS_ADMIN_EMAIL=admin@espelunca.blue

# SMTP para e-mails de confirmação e notificações do PDS.
# Nunca coloque a senha neste arquivo público. Preencha somente em config.env.
PDS_EMAIL_SMTP_URL=
PDS_EMAIL_FROM_ADDRESS=admin@espelunca.blue

INSTALL_DIR=/opt/espelunca-bluesky
PDS_DATA_DIR=/opt/espelunca-bluesky/pds-data
APP_DIR=/opt/espelunca-bluesky/social-app

# Portas locais, usadas pelo Cloudflare Tunnel.
PDS_PORT=3100
WEB_PORT=3101

# Branding do PDS e dos e-mails.
PDS_SERVICE_NAME=Espelunca
PDS_HOME_URL=https://espelunca.blue
PDS_LOGO_URL=https://espelunca.blue/espelunca-icon.svg
PDS_PRIMARY_COLOR=#006AFF
PDS_EMAIL_DISABLE_CONFIRMATION_LINK=true

INSTALL_DOCKER=true
CREATE_INITIAL_ACCOUNT=false

# Configuração opcional do Tunnel local da Espelunca.
# O instalador principal não altera o Tunnel automaticamente.
CLOUDFLARED_CONFIG=/home/espelunca/.cloudflared/config.yml
CLOUDFLARED_SERVICE=cloudflared-espelunca.service
