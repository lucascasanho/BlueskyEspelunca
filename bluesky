#!/usr/bin/env bash
set -Eeuo pipefail

SELF_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd -- "$(dirname -- "${SELF_PATH}")" && pwd)"

usage() {
  cat <<'EOF'
Uso:
  bluesky update
  bluesky status
  bluesky install
  bluesky start
  bluesky stop
  bluesky tunnel
  bluesky account
  bluesky feed <comando>
  bluesky ozone <comando>

Comandos:
  update   Atualiza este repositório e aplica a atualização do BlueskyEspelunca.
  status   Mostra o estado do PDS e do Web.
  install  Executa a instalação.
  start    Inicia o Web.
  stop     Para o Web.
  tunnel   Configura/valida o Cloudflare Tunnel existente.
  account  Cria uma conta no PDS.

Ozone Labeler:
  ozone install    Instala o Ozone e prepara a assinatura do Labeler.
  ozone start      Inicia o Ozone.
  ozone stop       Para o Ozone.
  ozone restart    Reinicia o Ozone.
  ozone status     Mostra estado e healthcheck.
  ozone logs       Mostra logs.
  ozone update     Atualiza as imagens do Ozone.

Feed Espelunca BR:
  feed install    Instala/atualiza o Feed Generator.
  feed start      Inicia o serviço do Feed.
  feed stop       Para o serviço do Feed.
  feed restart    Reinicia o serviço do Feed.
  feed status     Mostra estado e fila.
  feed logs       Mostra logs.
  feed publish    Publica o registro do Feed no Bluesky.
  feed seed       Preenche a fila com posts recentes.
  feed tunnel     Configura a rota do Feed no Cloudflare Tunnel.
EOF
}

if [[ ! -d "${ROOT_DIR}/.git" ]]; then
  echo "ERRO: BlueskyEspelunca não está em um clone Git."
  exit 1
fi

command="${1:-}"

case "${command}" in
  update)
    echo "==> Atualizando o repositório BlueskyEspelunca"

    # O GitHub é a fonte de verdade deste repositório. Alterações rastreadas
    # locais são guardadas automaticamente antes do pull, sem tocar em
    # config.env, que permanece fora do controle de versão.
    if [[ -n "$(git -C "${ROOT_DIR}" status --porcelain --untracked-files=no)" ]]; then
      STASH_NAME="bluesky-auto-backup-$(date +%Y%m%d-%H%M%S)"
      echo "==> Alterações locais detectadas; criando backup: ${STASH_NAME}"
      git -C "${ROOT_DIR}" stash push -m "${STASH_NAME}" -- .
    fi

    git -C "${ROOT_DIR}" pull --ff-only
    exec "${ROOT_DIR}/scripts/update.sh"
    ;;
  status)
    exec "${ROOT_DIR}/scripts/status.sh"
    ;;
  install)
    exec "${ROOT_DIR}/install.sh"
    ;;
  start)
    exec "${ROOT_DIR}/scripts/start-web.sh"
    ;;
  stop)
    exec "${ROOT_DIR}/scripts/stop-web.sh"
    ;;
  tunnel)
    exec "${ROOT_DIR}/scripts/configure-tunnel.sh"
    ;;
  account)
    exec "${ROOT_DIR}/scripts/create-account.sh"
    ;;
  feed)
    exec "${ROOT_DIR}/scripts/feed.sh" "${@:2}"
    ;;
  ozone)
    exec bash "${ROOT_DIR}/scripts/ozone.sh" "${@:2}"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Comando desconhecido: ${command}"
    echo
    usage
    exit 2
    ;;
esac
